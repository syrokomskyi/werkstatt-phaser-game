{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "noEmit": true,
    "declaration": true,
    "rewriteRelativeImportExtensions": true,
    "types": [
      "node"
    ],
    "rootDir": ".",
    "outDir": "dist",
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/__tests__/**",
    "dist/**",
    "node_modules/**"
  ]
}
